data/papers/*.pdf
data/fulltext/

# ── 运行时产物（不进版本控制）────────────────────────────────
data/abstracts.local.jsonl
data/.extract_cache.json
results/*.png

# 派生索引：可由 `agent.py index` 重建，不入库
data/index/

# 本地临时目录 / 依赖安装目录
.tmp/
.vendor/

# ── Python ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ── 模型与缓存（云端持久化目录，勿入库）─────────────────────
cache/
models/
*.safetensors
*.bin

# ── 编辑器 / 系统 ───────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log
